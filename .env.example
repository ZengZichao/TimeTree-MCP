# TimeTree MCP Server Configuration
# This file provides example configuration values.
# Copy this file to ".env" and adjust as needed.

# The base URL for the TimeTree web API.
# Default: https://timetree.org
TIMETREE_BASE_URL=https://timetree.org

# Request timeout in milliseconds.
# Default: 30000 (30 seconds)
TIMETREE_TIMEOUT=30000

# User-Agent header sent with HTTP requests.
# Default: timetree-mcp/0.1.0
TIMETREE_USER_AGENT=timetree-mcp/0.1.0
